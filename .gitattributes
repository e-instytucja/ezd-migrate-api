* text=auto

# Enforce LF for source and config files (cross-platform consistency)
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.env text eol=lf
*.htaccess text eol=lf
*.sh text eol=lf

# Keep Windows scripts with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
