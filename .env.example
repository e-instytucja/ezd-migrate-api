APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel_api
DB_USERNAME=laravel
DB_PASSWORD=secret

# --- Baza importu (pg_import na hoście), używana z kontenera app ---
# Sprawdź zmienne w kontenerze: docker exec pg_import env | grep POSTGRES
IMPORT_DB_HOST=host.docker.internal
IMPORT_DB_PORT=5433
IMPORT_DB_DATABASE=importdb
IMPORT_DB_USERNAME=postgres
IMPORT_DB_PASSWORD=postgres
