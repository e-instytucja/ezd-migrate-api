APP_NAME=SidasEzdApi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Warsaw

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Diagnostyka SQL (tylko dev / tymczasowo)
LOG_SQL_QUERIES=false
LOG_SQL_SLOW_MS=100
LOG_SQL_QUERIES_DETAIL=false

# Materialized views list API (false = live SQL, true = api_*_list MV)
# Wymaga: php artisan materialized-views:refresh przed USE_MATERIALIZED_VIEWS=true
USE_MATERIALIZED_VIEWS=false

# Shared secret z EZD (Migracje → Madkom → Konfiguracja). Wymagany — bez niego API zwraca 503.
# Nagłówek HTTP: madkom-api-token
MADKOM_API_TOKEN=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ezd_chojnice
DB_USERNAME=laravel
DB_PASSWORD=secret

# Cache – 'array' nie wymaga DB ani Redis
CACHE_STORE=array
FILES_URL="/var/www/files"

# Xdebug (Docker/WSL): ustaw IP hosta Windows widoczne z kontenera.
# Przyklad dla WSL:
XDEBUG_CLIENT_HOST=192.168.0.6
XDEBUG_CLIENT_PORT=9003
XDEBUG_IDEKEY=PHPSTORM
